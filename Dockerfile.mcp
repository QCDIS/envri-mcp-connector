FROM python:3.12-slim

WORKDIR /app

COPY requirements-mcp.txt .
RUN pip install --no-cache-dir -r requirements-mcp.txt

# Only kb_mcp + kb_common - kb_argo/kb_oso/kb_api aren't needed here, and
# kb_common's embed.py/hybrid_search.py are never imported by kb_mcp (search
# goes through kb_api's HTTP API instead), so no torch/sentence-transformers
# or GPU is needed in this image at all.
COPY src/kb_mcp src/kb_mcp
COPY src/kb_common src/kb_common

ENV PYTHONPATH=/app/src

EXPOSE 8765

CMD ["python", "-m", "kb_mcp.server"]
