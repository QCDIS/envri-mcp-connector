# Elasticsearch connection (matches docker-compose.yml's local single-node setup)
# ELASTIC_PASSWORD is read by docker-compose to set the `elastic` user's password.
ELASTIC_PASSWORD=elasticpass
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=elasticpass
ES_API_KEY=
ES_CA_CERT=
ES_VERIFY_CERTS=false

ES_INDEX=ifremer-knowledge-base

# Embedding model
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# Euro-Argo Fleet Monitoring API
ARGO_API_BASE=https://fleetmonitoring.euro-argo.eu
ARGO_RAW_DIR=data/argo/raw
ARGO_FETCH_WORKERS=8

# OSO ontology (local file, see data/oso/oso.owl)
OSO_OWL_PATH=data/oso/oso.owl

# NERC NVS vocabulary resolution (see src/kb_common/nerc_vocab.py).
NERC_TURTLES_ZIP=/home/anoel/Documents/Virtuoso/nerc-nvs-collections/turtles.zip

# IHO World Seas v3 shapefile (marineregions.org) for real named-sea
# classification
SEAS_SHAPEFILE_PATH=data/seas/World_Seas_IHO_v3.shp

# MCP server (src/kb_mcp/) - exposes the knowledge base as tools over
# streamable-http, see docker-compose.yml's kb-mcp service.
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Host header values callers are allowed to present (DNS-rebinding
# protection - see kb_mcp/server.py).
MCP_ALLOWED_HOSTS=localhost:8765,127.0.0.1:8765

# Single switch for kb-mcp/kb-api's security layer (auth + MCP_ALLOWED_HOSTS
# above) - true by default. Set to false to disable ALL of it at once, for
# local testing only.
KB_SECURITY_ENABLED=true

# Bearer tokens for kb-mcp and kb-api (src/kb_common/auth.py).
# - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
KB_READ_TOKENS=chatbot:changeme-generate-a-real-token,kb-mcp:changeme-generate-a-different-token
KB_ADMIN_TOKENS=

# The token kb-mcp itself presents to kb-api when it calls /internal/search
# (src/kb_mcp/search.py) - must be one of the entries in KB_READ_TOKENS
# above (e.g. the "kb-mcp:" one).
KB_MCP_INTERNAL_TOKEN=changeme-generate-a-different-token

# HTTP API (src/kb_api/) - plain JSON search with a fixed result shape
# (score/url/header/vector/summary/last_modified), for non-MCP consumers.
API_HOST=0.0.0.0
API_PORT=8080

# Per-stage search latency logging (kb_mcp's end-of-tool log line, kb_api's
# Server-Timing response header). Set to false to disable.
LOG_TIMING=false
